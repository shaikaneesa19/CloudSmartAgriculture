# Flask Backend Configuration
FLASK_APP=app.py
FLASK_ENV=development
DEBUG=True
PORT=5000
SECRET_KEY=change-this-in-production-smart-agriculture-secret-key

# Database Configuration (Default SQLite for local; switch to RDS PostgreSQL in production)
DATABASE_URL=sqlite:///agriculture.db
# Production AWS RDS Example:
# DATABASE_URL=postgresql://dbuser:securepassword@smart-agri-db.cxyz.us-east-1.rds.amazonaws.com:5432/smart_agriculture

# AWS Cloud Simulation / IoT Configuration
AWS_REGION=us-east-1
ENABLE_SIMULATED_DATA=True
SIMULATION_INTERVAL_SECONDS=10
ALERT_EMAIL_RECIPIENT=farmer-alerts@example.com
